# 애플리케이션 서버 및 접속 포트 설정
HOST=0.0.0.0
PORT=9921
DASHBOARD_PORT=9921

# UI 및 시뮬레이션 기본 설정
DEFAULT_THEME=light
AGV_COUNT=6
ACS_REPORT_INTERVAL_SEC=30
LOCAL_RECORD_INTERVAL_SEC=1
LOCAL_BUFFER_RETENTION_SEC=300

# 시계열 데이터 저장소(TSDB) 설정
TSDB_PATH=/app/tsdb_data/network_telemetry.db
TSDB_RETENTION_SEC=3600
TSDB_SEED_HISTORY_SEC=600
